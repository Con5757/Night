using terminal

#func add(num1, num2) {
    send num1 + num2
}

$func main() {
    #ans
    ans = add(1, 4) ; need to update extension to be able to detect 1 
                    ; as a number here and not a boolean
    if ans >= 11 {
        terminal.out("big num")
    } elif ans <= 9 {
        terminal.out("small num")
    } else {
        terminal.out("num is 10!")
    }
}