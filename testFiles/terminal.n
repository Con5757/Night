using terminal

#func add(num1, num2) {
    send num1 + num2
}

$func main() {
    #ans
    ans = add(1, 4) ; 1 even though highlighted as a boolean, will still be a integer

    if ans >= 11 {
        terminal.out("big num")
    } elif ans <= 9 {
        terminal.out("small num")
    } else {
        terminal.out("num is 10!")
    }
    kill
}